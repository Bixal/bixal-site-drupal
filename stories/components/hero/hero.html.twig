{#
/**
 * Hero component.
 *
 * Available variables:
 * - variant (string, optional): Component style. Options:
 *      - "image-bg"
 *      - "split" (video/image on one side, text on the other)
 * - heading_type (string, optional): HTML tag for main title. Defaults to "h1".
 * - sub_heading_type (string, optional): HTML tag for subtitle. Defaults to "h2".
 * - media_position (string, optional): Position of media when layout is "split". Options: "left" or "right". Defaults to "left".
 * - image (string, optional): Image URL for background or inline display.
 * - video (string, optional): Video URL for inline display.
 * - title (string): Main heading text. Defaults to "Hero title".
 * - title_callout (string, optional): Callout text within the main title.
 * - eyebrow (string, optional): Small text above the main title.
 * - subtitle (string, optional): Secondary heading below the main title.
 * - description (string, optional): Body text content.
 * - cta (object, optional): Call-to-action link. Calls the button component with:
 *     - label (string): Link text.
 *     - href (string): Link URL.
 *     - additional_classes (array, optional): Extra CSS classes to add.
 */
#}

{# Attribute checks. #}
{% if attributes is empty %}
  {% set attributes = create_attribute() %}
{% endif %}

{# Heading checks. #}
{% set heading_type = heading_type|default("h1") %}
{% set sub_heading_type = sub_heading_type|default("h2") %}

{# Media checks. #}
{% set has_media = image or video %}
{% set media_position = media_position|default("left") %}
{% set has_background_image = variant == "image-bg" and image %}
{% if has_background_image %}
  {% set attributes = attributes.setAttribute('style', '--hero-image: url(' ~ image ~ ')') %}
{% endif %}

{# Call-to-action checks. #}
{% set cta_exists = cta.label and cta.href %}

{% set hero_classes = [
  "bix-hero",
  (variant ? "bix-hero--" ~ variant),
  (layout ? "bix-hero--" ~ layout),
  (layout == "split" ? "bix-hero--split-" ~ media_position),
]|merge(additional_classes|default([])) %}

<section {{ attributes.addClass(hero_classes) }}>
  <div class="bix-hero__container bix-container">
    {% if has_media and layout == "split" %}
      <div class="bix-hero__media">
        {% if image %}
        <img src="{{ image }}" alt="" aria-hidden="true" />
        {% endif %}
        {% if video %}
        <video src="{{ video }}" autoplay muted loop></video>
        {% endif %}
      </div>
    {% endif %}

    <div class="bix-hero__content">

      {# Header section #}
      <div class="bix-hero__header">
        {% if eyebrow %}
          <div class="bix-title-prefix">{{ eyebrow }}</div>
        {% endif %}

        {% if title %}
        <{{ heading_type }} class="bix-hero__title">
          {{ title|default("Hero title") }}
          {% if title_callout %}
            <span class="bix-hero__callout">{{ title_callout }}</span>
          {% endif %}
        </{{ heading_type }}>
        {% endif %}

        {% if subtitle %}
        <{{ sub_heading_type }} class="bix-hero__subtitle">
          {{ subtitle|default("Hero subtitle") }}
        </{{ sub_heading_type }}>
        {% endif %}
      </div>
      {# /Header #}

      {# Body #}
      {% if description %}
      <div class="bix-hero__body">
        <p>
          {{ description }}
        </p>
      </div>
      {% endif %}
      {# /Body #}

      {# Footer #}
      {% if cta_exists %}
        <div class="bix-hero__footer">
          <div class="bix-hero__cta">
            {% set cta = cta|merge({'additional_classes': ["bix-hero__cta-button"]}) %}
            {% include "@components/button/button.html.twig" ignore missing with cta %}
          </div>
        </div>
      {% endif %}
      {# /Footer #}
    </div>
  </div>
</section>

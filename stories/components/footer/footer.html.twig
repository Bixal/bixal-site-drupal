{#
/**
  * Footer component
  *
  * Available variables:
  * - logo (object, optional): Footer logo configuration.
  *   - src (string): The URL path to the logo image file.
  *   - alt (string): Alternative text description for the logo image.
  * - columns (array): Collection of footer content columns including about section, headquarters info, and accreditations.
  *   - title (string, optional): The heading text displayed at the top of each column.
  *   - body (string, optional): The HTML content displayed within each column.
  * - siteNav (array, optional): Collection of main site navigation links.
  *   - label (string): The visible text for the navigation link.
  *   - href (string, optional): The URL destination for the link.
  *   - current (boolean, optional): Indicates if this link represents the current page.
  * - legalNav (array, optional): Collection of legal and policy navigation links.
  *   - label (string): The visible text for the legal link.
  *   - href (string): The URL destination for the legal link.
  * - socialNav (object, optional): Configuration data for the social media navigation component.
  *   - variant (string, optional): The styling variant class applied to the social navigation.
  *   - aria_label (string): Unique accessibility label for screen readers when multiple social navs exist on the same page.
  *   - items (array): Collection of social media platform links and icons.
  * - footer_nav_cl (string, optional): Drupal contextual links output for footer navigation editing.
  * - legal_nav_cl (string, optional): Drupal contextual links output for legal navigation editing.
**/
#}

<footer id="site-footer" class="bix-site-footer">
  <section class="bix-container  bix-site-footer__primary">
    <div class="bix-site-footer__columns">
      {% if logo.src %}
      <div class="bix-site-footer__column">
        <div class="bix-site-footer__logo">
          <img role="presentation" aria-hidden="true" decoding="async" loading="lazy" src="{{ logo.src }}" alt="{{ logo.alt }}">
        </div>
      </div>
      {% endif %}
      {% for item in columns %}
      <div class="bix-site-footer__column">
        {% if item.title %}
        <h3 class="bix-site-footer__title">{{ item.title }}</h3>
        {% endif %}

        {% if item.body %}
        {{ item.body }}
        {% endif %}


        {# @TODO: See if this is still needed #}
        {% if theme_hook_original %}
          {{ config_pages_field('accreditations', 'field_links', 'full') }}
          <div class="accreditations-logos">
            {{ config_pages_field('accreditations', 'field_logos_paragraph', 'full') }}
          </div>
        {% endif %}

      </div>
      {% endfor %}
    </div>
  </section>
  <section id="bix-site-footer__secondary" class="bix-site-footer__secondary">
    <div class="bix-site-footer__secondary-container bix-container">
      {% if siteNav %}
        <nav class="bix-site-footer__secondary-nav" aria-label="Site links">
          {# Footer nav contextual links #}
          {{ footer_nav_cl }}
          <ul class="bix-site-footer__secondary-nav-items">
            {% for item in siteNav %}
              <li class="bix-site-footer__secondary-nav__item">
                <a class="{{ item.current ? "is-current" }}" href="{{ item.href | default("javascript:void(0)") }}">
                  {{ item.label }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      {% set copyright_text = 'Copyright &copy; ' ~ ('now' | date('Y')) ~ ' Bixal' %}
      <div class="bix-site-footer__legal">
        <span class="copyright">{{ copyright_text }}</span>

        {% if legalNav %}
          {# Legal nav contextual links. #}
          {{ legal_nav_cl }}

          {% for item in legalNav %}
            <a href="{{ item.href }}">{{ item.label }}</a>
          {% endfor %}
        {% endif %}
      </div>

      {% if socialNav %}
        {% include "@components/social-nav/social-nav.html.twig" with socialNav %}
      {% endif %}
    </div>
  </section>
</footer>

{
  "name": "@bixal/site-drupal",
  "version": "1.0.0-beta",
  "description": "",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "chromatic": "chromatic --exit-zero-on-changes",
    "format:js": "prettier './**/*.js' --check",
    "format:js:fix": "prettier './**/*.js' --write",
    "format:styles": "prettier './**/*.scss' --check",
    "format:styles:fix": "prettier './**/*.scss' --write",
    "lint:styles": "stylelint './**/*.scss'",
    "lint:styles:fix": "stylelint './**/*.scss' --fix",
    "lint:js": "eslint",
    "lint:js:fix": "eslint --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npm run storybook",
    "storybook": "storybook dev -p 80",
    "storybook:local": "storybook dev -p 5050",
    "build-storybook": "storybook build",
    "build-drupal-theme": "npm run build -w bixaldrop",
    "static-sb": "npm run build-storybook && npx http-server storybook-static/",
    "check-updates": "npx npm-check-updates --interactive --format group --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bixal/bixal-site-drupal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Bixal/bixal-site-drupal/issues"
  },
  "homepage": "https://github.com/Bixal/bixal-site-drupal#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/html-vite": "10.6.0",
    "@storybook/icons": "2.1.0",
    "@uswds/uswds": "3.14.0",
    "chromatic": "15.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "storybook": "10.6.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "vite-plugin-twig-drupal": "1.6.2"
  },
  "workspaces": [
    "web/themes/custom/bixal_uswds"
  ]
}

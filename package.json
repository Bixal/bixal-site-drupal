{
  "name": "@bixal/site-drupal",
  "version": "1.0.0-beta",
  "description": "",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "chromatic": "chromatic --exit-zero-on-changes",
    "format:js": "prettier './**/*.js' --check",
    "format:js:fix": "prettier './**/*.js' --write",
    "format:styles": "prettier './**/*.scss' --check",
    "format:styles:fix": "prettier './**/*.scss' --write",
    "lint:styles": "stylelint './**/*.scss'",
    "lint:styles:fix": "stylelint './**/*.scss' --fix",
    "lint:js": "eslint",
    "lint:js:fix": "eslint --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npm run storybook",
    "storybook": "storybook dev -p 80",
    "storybook:local": "storybook dev -p 5050",
    "build-storybook": "storybook build",
    "static-sb": "npm run build-storybook && npx http-server storybook-static/",
    "deps:minor": "ncu --workspaces --cooldown 7 --target minor",
    "deps:minor:apply": "ncu --workspaces --cooldown 7 --target minor --upgrade && npm install",
    "deps:major": "ncu --workspaces --cooldown 7 --target latest --configFileName .ncurc.major.mjs",
    "deps:security": "./orch/deps_security.sh",
    "deps:verify": "./orch/build_node.sh && npm run lint:js && npm run lint:styles && npm run build-storybook"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bixal/bixal-site-drupal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Bixal/bixal-site-drupal/issues"
  },
  "homepage": "https://github.com/Bixal/bixal-site-drupal#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/html-vite": "10.6.1",
    "@storybook/icons": "2.1.0",
    "@uswds/uswds": "3.14.0",
    "chromatic": "15.3.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "17.13.0",
    "npm-check-updates": "23.1.0",
    "prettier": "3.9.9",
    "sass": "1.105.1",
    "sass-embedded": "1.105.1",
    "storybook": "10.6.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "vite-plugin-twig-drupal": "1.7.0"
  },
  "overrides": {
    "postcss": "8.5.29",
    "esbuild": "0.28.2",
    "twig": "3.0.0",
    "locutus": "3.0.36"
  },
  "workspaces": [
    "stories",
    "web/themes/custom/bixal_uswds"
  ],
  "engines": {
    "npm": ">=11.19.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false
  }
}

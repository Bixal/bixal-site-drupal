save-exact=true

# Supply-chain guards. These need npm >= 11.19.0 (see "engines" in
# package.json), and engine-strict makes older npm refuse to install rather
# than silently ignoring them.
engine-strict=true

# Never resolve a version published less than 7 days ago. Most malicious
# releases are caught and pulled within that window. To take an urgent
# security fix sooner, add the package to min-release-age-exclude.
min-release-age=7

# Dependency install scripts only run when approved in "allowScripts" in
# package.json. Unreviewed ones fail the install instead of just warning.
strict-allow-scripts=true
